# Server only. Leave empty to run the local demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments (cards worldwide + UPI in India). DODO_ENV=test or live.
DODO_ENV=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_FOUNDER_PRODUCT_ID=
DODO_SEAT_PRODUCT_ID=

# Browser-side keys for the live build
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
